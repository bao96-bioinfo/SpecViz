          ],
          "notes": [
            "- [ ] Prepare consistent input data and save training/evaluation assignments.",
            "- [ ] Add the trial checks and full training run.",
            "- [ ] Keep evaluation answers hidden until predictions are complete.",
            "- [ ] Compare predictions with the saved answers.",
            "- [ ] Save the settings, assignments, predictions, and measured error.",
            "These checkboxes describe planned work; completion and verification evidence are not available."
          ]
        }
