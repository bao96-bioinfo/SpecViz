    {
      "id": "openspec/changes/reproducible-model-training/proposal.md",
      "purpose": "Train one model and evaluate it using answers kept out of training.",
      "layout": "rules",
      "items": [
        {
          "id": "proposal.md#meaning",
          "label": "Repeatable model training",
          "summary": "Train one model and evaluate it using answers kept out of training.",
          "kind": "rule",
          "sources": [
            "openspec/changes/reproducible-model-training/proposal.md:L1-1",
            "openspec/changes/reproducible-model-training/proposal.md:L3-3",
            "openspec/changes/reproducible-model-training/proposal.md:L5-5"
          ],
          "notes": [
            "Build a workflow that combines several datasets, trains one model, and evaluates predictions using answers the model has not seen.",
            "Keep enough records to repeat a run and understand its results. This proposal does not claim that the workflow is implemented."
          ]
        }
      ],
      "relationships": []
    },
    {
      "id": "openspec/changes/reproducible-model-training/specs/data-preparation/spec.md",
      "purpose": "Use consistent input fields and reuse saved training and evaluation groups.",
      "layout": "rules",
      "items": [
        {
          "id": "specs/data-preparation/spec.md#meaning",
          "label": "Prepare consistent samples",
          "summary": "Use consistent input fields and reuse saved training and evaluation groups.",
          "kind": "rule",
          "sources": [
            "openspec/changes/reproducible-model-training/specs/data-preparation/spec.md:L1-1",
            "openspec/changes/reproducible-model-training/specs/data-preparation/spec.md:L3-3",
            "openspec/changes/reproducible-model-training/specs/data-preparation/spec.md:L5-5"
          ],
          "notes": [
            "Combine datasets using the same field names and units. Divide the samples into training and evaluation groups before training starts.",
            "Save each sample's group assignment. Supporting notes call this a \"persisted split\": resuming a run must reuse the same saved assignments instead of dividing the samples again."
          ]
        }
      ],
      "relationships": []
    },
    {
      "id": "openspec/changes/reproducible-model-training/specs/evaluation/spec.md",
      "purpose": "Measure prediction error; the acceptable error threshold is still undecided.",
      "layout": "rules",
      "items": [
        {
          "id": "specs/evaluation/spec.md#meaning",
          "label": "Measure prediction error",
          "summary": "Measure prediction error; the acceptable error threshold is still undecided.",
          "kind": "rule",
          "sources": [
            "openspec/changes/reproducible-model-training/specs/evaluation/spec.md:L1-1",
            "openspec/changes/reproducible-model-training/specs/evaluation/spec.md:L3-3",
            "openspec/changes/reproducible-model-training/specs/evaluation/spec.md:L5-5"
          ],
          "notes": [
            "Compare saved predictions with the evaluation answers kept out of training. Report the measured error.",
            "The acceptable error threshold is undecided. Do not declare that the model is ready for use on the basis of an unspecified threshold."
          ]
        }
      ],
      "relationships": []
    },
    {
      "id": "openspec/changes/reproducible-model-training/specs/predictions/spec.md",
      "purpose": "Predict answers for evaluation samples without revealing their known answers.",
      "layout": "rules",
      "items": [
        {
          "id": "specs/predictions/spec.md#meaning",
          "label": "Predict unseen answers",
          "summary": "Predict answers for evaluation samples without revealing their known answers.",
          "kind": "rule",
          "sources": [
            "openspec/changes/reproducible-model-training/specs/predictions/spec.md:L1-1",
            "openspec/changes/reproducible-model-training/specs/predictions/spec.md:L3-3"
          ],
          "notes": [
            "After training finishes, apply the trained model to the evaluation samples. Keep their known answers hidden until all predictions have been saved."
          ]
        }
      ],
      "relationships": []
    },
    {
      "id": "openspec/changes/reproducible-model-training/specs/run-records/spec.md",
      "purpose": "Save enough information for another person to repeat and check the run.",
      "layout": "rules",
      "items": [
        {
          "id": "specs/run-records/spec.md#meaning",
          "label": "Keep repeatable run records",
          "summary": "Save enough information for another person to repeat and check the run.",
          "kind": "rule",
          "sources": [
            "openspec/changes/reproducible-model-training/specs/run-records/spec.md:L1-1",
            "openspec/changes/reproducible-model-training/specs/run-records/spec.md:L3-3"
          ],
          "notes": [
            "After evaluation, save the model settings, sample assignments, predictions, and measured error. Another person must be able to identify the input datasets and repeat the run from these records."
          ]
        }
      ],
      "relationships": []
    },
    {
      "id": "openspec/changes/reproducible-model-training/specs/training-run/spec.md",
      "purpose": "Run a small trial first; train fully only after its checks pass.",
      "layout": "rules",
      "items": [
        {
          "id": "specs/training-run/spec.md#meaning",
          "label": "Run training reproducibly",
          "summary": "Run a small trial first; train fully only after its checks pass.",
          "kind": "rule",
          "sources": [
            "openspec/changes/reproducible-model-training/specs/training-run/spec.md:L1-1",
            "openspec/changes/reproducible-model-training/specs/training-run/spec.md:L3-3",
            "openspec/changes/reproducible-model-training/specs/training-run/spec.md:L5-5",
            "openspec/changes/reproducible-model-training/specs/training-run/spec.md:L7-7"
          ],
          "notes": [
            "Use the same specified model settings for every full training run. Supporting notes call these settings the \"fixed recipe\".",
            "Run a small trial first and check that inputs load, training completes, and output can be saved. Supporting notes call this a \"smoke gate\". Start full training only if every trial check passes; otherwise stop and report the failed checks.",
            "When resuming a run, load its saved settings and sample assignments. Never include the evaluation answers in training."
          ]
        }
      ],
      "relationships": []
    },
    {
