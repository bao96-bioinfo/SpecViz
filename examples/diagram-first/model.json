  "schema_version": 1,
  "snapshot": "1a5c7ea729b016baf40adeac9de0509738159e2afa8056d5eebc93a17b00d2e9",
  "project_purpose": "Train a model from several datasets and compare its predictions with answers kept out of training.",
  "documents": [
    {
      "id": "openspec/changes/reproducible-model-training/design.md",
      "purpose": "Prepare samples, train the model, compare predictions, and retain the run records.",
      "layout": "flow",
      "items": [
        {
          "id": "prepare",
          "label": "Prepare the samples",
          "summary": "Use consistent fields and units, then save which samples belong to training and evaluation.",
          "kind": "behavior",
          "sources": [
            "openspec/changes/reproducible-model-training/design.md:L1-1",
            "openspec/changes/reproducible-model-training/design.md:L3-3",
            "openspec/changes/reproducible-model-training/design.md:L5-5"
          ],
          "notes": [
            "Put the datasets into one consistent format. Divide the samples into a training group and an evaluation group, and save those assignments."
          ]
        },
        {
          "id": "train",
          "label": "Train the model",
          "summary": "Run a small trial first. Train fully only if its checks pass; otherwise stop and report the failures.",
          "kind": "behavior",
          "sources": [
            "openspec/changes/reproducible-model-training/design.md:L7-7",
            "openspec/changes/reproducible-model-training/design.md:L9-9"
          ],
          "notes": [
            "Send only the training group to model training. Use the same settings for every run. Run a small trial first; start the full run only if the trial passes its checks. Otherwise stop and report the failed checks."
          ]
        },
        {
          "id": "reserve",
          "label": "Keep evaluation answers separate",
          "summary": "Keep the known evaluation answers hidden from training and prediction.",
          "kind": "behavior",
          "sources": [
            "openspec/changes/reproducible-model-training/design.md:L11-11",
            "openspec/changes/reproducible-model-training/design.md:L13-13"
          ],
          "notes": [
            "Keep the evaluation group's known answers separate from training and prediction. Do not reveal them to the model."
          ]
        },
        {
          "id": "predict",
          "label": "Make predictions",
          "summary": "Use the trained model to predict answers for the evaluation samples.",
          "kind": "behavior",
          "sources": [
            "openspec/changes/reproducible-model-training/design.md:L15-15",
            "openspec/changes/reproducible-model-training/design.md:L17-17"
          ],
          "notes": [
            "After training finishes, use the trained model to predict answers for the evaluation samples without revealing their known answers."
          ]
        },
        {
          "id": "evaluate",
          "label": "Compare predictions with answers",
          "summary": "Measure prediction error. The acceptable error threshold is still undecided.",
          "kind": "behavior",
          "sources": [
            "openspec/changes/reproducible-model-training/design.md:L19-19",
            "openspec/changes/reproducible-model-training/design.md:L21-21"
          ],
          "notes": [
            "Compare the predictions with the answers kept aside earlier. The acceptable error threshold is not yet decided; report the measured error without declaring the model ready for use."
          ]
        },
        {
          "id": "record",
          "label": "Save the run records",
          "summary": "Save settings, sample assignments, predictions, and measured error so the run can be repeated.",
          "kind": "behavior",
          "sources": [
            "openspec/changes/reproducible-model-training/design.md:L23-23",
            "openspec/changes/reproducible-model-training/design.md:L25-25"
          ],
          "notes": [
            "After evaluation, save the settings, sample assignments, predictions, and measured error so another person can repeat the run and check its results."
          ]
        }
      ],
